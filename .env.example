# =============================================================================
# Talitha Psicologia - Environment Variables
# =============================================================================
# Copy to .env.local and fill in the values.
# NEVER commit .env.local — it contains real secrets.
# =============================================================================

# --- Public (safe to expose in browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only secrets (NEVER prefix with NEXT_PUBLIC_) ---

# Supabase service role — bypasses RLS; used only in src/lib/supabase/admin.ts
# SUPABASE_SERVICE_ROLE_KEY=

# Encryption keys — 32 bytes base64 each; losing RECORD_KEK = permanent data loss
# RECORD_ENCRYPTION_KEK_V1=
# CPF_INDEX_KEY=

# Resend — email transacional (user-initiated: convites, notificacoes)
# RESEND_API_KEY_APP=

# Email sender (neutral — must not reveal clinical context)
EMAIL_FROM=noreply@example.com

# --- Supabase secrets (set via supabase secrets set, NOT here) ---
# ASAAS_API_KEY        — Edge Functions only
# ASAAS_WEBHOOK_TOKEN  — Edge Function asaas-webhook
# ASAAS_BASE_URL       — https://api-sandbox.asaas.com/v3 (dev) / https://api.asaas.com/v3 (prod)
# LIVEKIT_API_KEY      — Edge Function issue-livekit-token
# LIVEKIT_API_SECRET   — Edge Function issue-livekit-token
# LIVEKIT_URL          — Edge Function delete-livekit-room
# SITE_URL             — Edge Functions de cron (links do portal)
# RESEND_API_KEY_CRON  — Edge Functions de cron
# CRON_SECRET          — Edge Functions de cron (Vault)
